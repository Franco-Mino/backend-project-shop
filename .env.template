# ─────────────────────────────────────────────────────────────────────────────
# PROJECT SHOP — ENVIRONMENT VARIABLES TEMPLATE
#
# Cómo usar:
#   cp .env.template .env
#   Completá cada variable con tus valores reales.
#   NUNCA comitees el archivo .env (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto en el que escucha la API (default 3000)
PORT=3000

# Orígenes permitidos en producción (separados por coma, sin espacios)
# Ejemplo: https://mi-tienda.com,https://admin.mi-tienda.com
# En desarrollo se permite cualquier origen automáticamente.
ALLOWED_ORIGINS=http://localhost:3000


# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Desarrollo local sin Docker: localhost
# Desarrollo local con Docker: db  (nombre del servicio en docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_shop
DB_USERNAME=postgres
DB_PASSWORD=change_me


# ─────────────────────────────────────────────────────────────────────────────
# JWT — AUTENTICACIÓN
# ─────────────────────────────────────────────────────────────────────────────

# Secreto para firmar access tokens. Debe ser una cadena larga y aleatoria.
# Generá uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_in_production

# Duración del access token (formato: 15m, 1h, 24h)
JWT_EXPIRES_IN=24h

# Duración del refresh token en días
REFRESH_TOKEN_EXPIRES_DAYS=7


# ─────────────────────────────────────────────────────────────────────────────
# AWS S3 — ALMACENAMIENTO DE IMÁGENES
# ─────────────────────────────────────────────────────────────────────────────

# Nombre del bucket S3 (debe existir y ser accesible con las credenciales)
AWS_BUCKET_NAME=my-bucket-name

# Región del bucket (ej: us-east-1, sa-east-1)
AWS_BUCKET_REGION=us-east-1

# Credenciales IAM. Usar un usuario con permisos mínimos (solo s3:PutObject, s3:DeleteObject).
# NUNCA uses credenciales de root de AWS.
AWS_PUBLIC_KEY=AKIA_REPLACE_ME
AWS_SECRET_KEY=replace_me_with_secret_key


# ─────────────────────────────────────────────────────────────────────────────
# SMTP — ENVÍO DE EMAILS
# ─────────────────────────────────────────────────────────────────────────────

# Gmail:    host=smtp.gmail.com  port=587  secure=false  pass=app_password_de_gmail
# SendGrid: host=smtp.sendgrid.net  port=587  user=apikey  pass=SG.xxxxx
# Resend:   host=smtp.resend.com   port=587  user=resend  pass=re_xxxxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=Project Shop <noreply@projectshop.com>


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE RECAPTCHA v2 (opcional)
# ─────────────────────────────────────────────────────────────────────────────

# Si está vacío, el captcha se deshabilita automáticamente (útil en desarrollo).
# Obtené tu secret key en: https://www.google.com/recaptcha/admin
# La site key (pública) va en el frontend. Esta clave va solo en el backend.
RECAPTCHA_SECRET_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# PGADMIN (opcional — solo desarrollo local con Docker)
# Acceso en: http://localhost:5050
# Solo se levanta con: docker-compose --profile tools up
# ─────────────────────────────────────────────────────────────────────────────

PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
