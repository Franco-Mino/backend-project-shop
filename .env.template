# Configuration in AppModule
DB_HOST=----
DB_PORT=----
DB_USERNAME=-----
# Database configuration Docker
DB_PASSWORD=-------
DB_NAME=-----

# JWT Configuration
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=24h

# Refresh Token Configuration
# Duración del refresh token en días (default: 7)
REFRESH_TOKEN_EXPIRES_DAYS=7

# AWS S3 Configuration
AWS_BUCKET_NAME=----
AWS_BUCKET_REGION=----
AWS_PUBLIC_KEY=----
AWS_SECRET_KEY=----

# SMTP Email Configuration (for password recovery & welcome emails)
# Gmail example: host=smtp.gmail.com, port=587, secure=false, user=tu@gmail.com, pass=app_password
# SendGrid example: host=smtp.sendgrid.net, port=587, user=apikey, pass=SG.xxxxx
# Resend example: host=smtp.resend.com, port=587, user=resend, pass=re_xxxxx
SMTP_HOST=----
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=----
SMTP_PASS=----
SMTP_FROM=Project Shop <noreply@projectshop.com>

# Google reCAPTCHA v2 (optional — if not set, captcha is bypassed in dev)
# Get your secret key at: https://www.google.com/recaptcha/admin
# Site key goes in the frontend. Secret key goes here (backend only).
RECAPTCHA_SECRET_KEY=----
