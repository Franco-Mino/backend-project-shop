# Variables de entorno para tests E2E locales
# Apunta a una DB de test separada (no la de desarrollo)
# Asegurate de tener corriendo: docker-compose up db

NODE_ENV=test

DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_shop_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=test_jwt_secret_only_for_testing
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=1

# AWS — no se usa en e2e, pero el módulo requiere las vars
AWS_BUCKET_NAME=test-bucket
AWS_BUCKET_REGION=us-east-1
AWS_PUBLIC_KEY=test-key
AWS_SECRET_KEY=test-secret

# SMTP — el email service es mockeado en e2e, pero las vars deben existir
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=test@test.com

# Captcha desactivado en test (sin secret key = bypass automático)
RECAPTCHA_SECRET_KEY=
